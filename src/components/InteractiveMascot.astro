---
const ringRadii = [108, 122, 136, 150, 164, 178, 192];
---

<div class="xt-orbit-stage">
	<svg class="xt-orbit-svg" viewBox="0 0 420 420" fill="none" aria-hidden="true">
		{ringRadii.map((r, i) => (
			<circle
				class="xt-orbit-ring"
				data-ring={i}
				cx="210"
				cy="210"
				r={r}
			/>
		))}
	</svg>

	<xt-mascot class="xt-mascot-wrap" role="button" tabindex="0" aria-label="XROSS mascot (click to say hi)">
		<svg class="xt-mascot-svg" xmlns="http://www.w3.org/2000/svg" viewBox="5 5 54 54" fill="none">
			<g class="xt-m-root">
				<g class="xt-m-leaf">
					<path d="M32.5 14.2C35.8 8.2 42.8 7.4 46.2 10.4C43.6 15.2 37.8 17 32.5 14.2Z" fill="#caffbf"/>
				</g>
				<g class="xt-m-body">
					<path
						class="xt-m-shell"
						d="M32 18.5C27.5 14.8 19.5 15.2 15 20.5C10.5 25.8 11 35 14.5 41.5C15.6 43.4 17 44.6 18.2 45.6C15.6 48.2 13.2 50 11.8 51.5C10.4 53 12 56.2 15.2 56.2C18.6 56.2 21.4 53.5 23.2 50C23.8 53 24.4 56.2 27 56.2C29.4 56.2 30.4 53.2 31 50.2H33C33.6 53.2 34.6 56.2 37 56.2C39.6 56.2 40.2 53 40.8 50C42.6 53.5 45.4 56.2 48.8 56.2C52 56.2 53.6 53 52.2 51.5C50.8 50 48.4 48.2 45.8 45.6C47 44.6 48.4 43.4 49.5 41.5C53 35 53.5 25.8 49 20.5C44.5 15.2 36.5 14.8 32 18.5Z"
						fill="#fdffb6"
					/>
					<path d="M18.5 25.5C19.8 22.2 22.5 20.2 25.8 19.8" stroke="#ffffff" stroke-opacity="0.72" stroke-width="3.2" stroke-linecap="round"/>
				</g>
				<g class="xt-m-face">
					<ellipse cx="21" cy="38.2" rx="3.4" ry="2" fill="#ffadad" opacity="0.8"/>
					<ellipse cx="43" cy="38.2" rx="3.4" ry="2" fill="#ffadad" opacity="0.8"/>
					<path d="M29.4 38C30.7 39.8 33.3 39.8 34.6 38" stroke="#292524" stroke-width="2.4" stroke-linecap="round"/>
				</g>
				<g class="xt-m-eyes">
					<circle cx="25.5" cy="34" r="3.1" fill="#292524"/>
					<circle cx="38.5" cy="34" r="3.1" fill="#292524"/>
					<circle cx="26.5" cy="32.8" r="1.15" fill="#ffffff"/>
					<circle cx="39.5" cy="32.8" r="1.15" fill="#ffffff"/>
				</g>
			</g>
		</svg>
	</xt-mascot>
</div>

<style>
	.xt-orbit-stage {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: clamp(16rem, 26vw, 22rem);
		height: clamp(16rem, 26vw, 22rem);
	}

	.xt-orbit-svg {
		position: absolute;
		inset: -14%;
		width: 128%;
		height: 128%;
		pointer-events: none;
		overflow: visible;
	}

	.xt-orbit-ring {
		stroke: rgba(148, 163, 184, 0.16);
		stroke-width: 1.2;
		transition: stroke 220ms ease, stroke-width 220ms ease, filter 220ms ease;
	}

	:global(:root[data-theme='light']) .xt-orbit-ring {
		stroke: rgba(15, 23, 42, 0.11);
	}

	.xt-orbit-ring.is-lit {
		stroke: #caffbf;
		stroke-width: 2.6;
		filter: drop-shadow(0 0 8px rgba(202, 255, 191, 0.7));
	}

	:global(:root[data-theme='light']) .xt-orbit-ring.is-lit {
		stroke: #40c057;
		stroke-width: 2.6;
		filter: drop-shadow(0 0 6px rgba(64, 192, 87, 0.45));
	}

	.xt-mascot-wrap {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		user-select: none;
		outline: none;
	}

	.xt-mascot-svg {
		width: clamp(9.5rem, 14.5vw, 12.2rem);
		height: clamp(9.5rem, 14.5vw, 12.2rem);
		overflow: visible;
		filter: drop-shadow(0 20px 44px rgba(0, 0, 0, 0.34));
		animation: xt-float 6s ease-in-out infinite;
	}

	:global(:root[data-theme='light']) .xt-mascot-svg {
		filter: drop-shadow(0 16px 32px rgba(15, 23, 42, 0.14));
	}

	:global(:root[data-theme='light']) .xt-m-shell {
		stroke: #e4e08e;
		stroke-width: 1.4;
		stroke-linejoin: round;
	}

	.xt-m-root {
		transform-box: fill-box;
		transform-origin: 50% 60%;
		will-change: transform;
	}

	.xt-m-leaf {
		transform-origin: 33px 15px;
		will-change: transform;
	}

	.xt-m-eyes {
		transform-origin: 32px 34px;
		will-change: transform;
	}

	.xt-m-face {
		will-change: transform;
	}

	.xt-mascot-wrap.is-boing .xt-m-root {
		animation: xt-boing 520ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.xt-mascot-wrap.is-boing .xt-m-eyes {
		animation: xt-blink 240ms ease-in-out;
	}

	@keyframes xt-float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-7px); }
	}

	@keyframes xt-boing {
		0% { transform: scale(1, 1); }
		25% { transform: scale(1.1, 0.88) translateY(2px); }
		55% { transform: scale(0.94, 1.09) translateY(-5px); }
		80% { transform: scale(1.03, 0.98); }
		100% { transform: scale(1, 1); }
	}

	@keyframes xt-blink {
		0%, 100% { transform: scaleY(1); }
		50% { transform: scaleY(0.12); }
	}

	@media (prefers-reduced-motion: reduce) {
		.xt-mascot-svg {
			animation: none;
		}
	}
</style>

<script>
	class XtMascot extends HTMLElement {
		private rafId = 0;
		private targetX = 0;
		private targetY = 0;
		private curX = 0;
		private curY = 0;
		private curLeaf = 0;
		private bgTargetX = 50;
		private bgTargetY = 28;
		private bgCurX = 50;
		private bgCurY = 28;
		private reduced = false;

		connectedCallback() {
			this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const root = this.querySelector<SVGGElement>('.xt-m-root');
			const leaf = this.querySelector<SVGGElement>('.xt-m-leaf');
			const eyes = this.querySelector<SVGGElement>('.xt-m-eyes');
			const face = this.querySelector<SVGGElement>('.xt-m-face');
			const bg = document.querySelector<HTMLElement>('.hero-bg');

			const tick = () => {
				const ease = 0.14;
				this.curX += (this.targetX - this.curX) * ease;
				this.curY += (this.targetY - this.curY) * ease;
				this.curLeaf += (this.targetX * 7 - this.curLeaf) * 0.08;

				this.bgCurX += (this.bgTargetX - this.bgCurX) * 0.09;
				this.bgCurY += (this.bgTargetY - this.bgCurY) * 0.09;

				if (eyes) {
					eyes.style.transform = `translate(${(this.curX * 2.4).toFixed(2)}px, ${(this.curY * 2.1).toFixed(2)}px)`;
				}
				if (face) {
					face.style.transform = `translate(${(this.curX * 1.05).toFixed(2)}px, ${(this.curY * 0.9).toFixed(2)}px)`;
				}
				if (root && !this.classList.contains('is-boing')) {
					const tilt = (this.curX * 4.2).toFixed(2);
					const tx = (this.curX * 2.2).toFixed(2);
					const ty = (this.curY * 1.8).toFixed(2);
					root.style.transform = `translate(${tx}px, ${ty}px) rotate(${tilt}deg)`;
				}
				if (leaf) {
					leaf.style.transform = `rotate(${this.curLeaf.toFixed(2)}deg)`;
				}
				if (bg) {
					bg.style.setProperty('--mx', `${this.bgCurX.toFixed(2)}%`);
					bg.style.setProperty('--my', `${this.bgCurY.toFixed(2)}%`);
				}

				const settled =
					Math.abs(this.targetX - this.curX) < 0.002 &&
					Math.abs(this.targetY - this.curY) < 0.002 &&
					Math.abs(this.bgTargetX - this.bgCurX) < 0.05 &&
					Math.abs(this.bgTargetY - this.bgCurY) < 0.05;

				if (settled) {
					this.rafId = 0;
				} else {
					this.rafId = requestAnimationFrame(tick);
				}
			};

			const schedule = () => {
				if (!this.rafId && !this.reduced) {
					this.rafId = requestAnimationFrame(tick);
				}
			};

			const onMove = (e: PointerEvent) => {
				if (e.pointerType === 'touch') return;
				const cx = window.innerWidth / 2;
				const cy = window.innerHeight / 2;
				const nx = Math.max(-1, Math.min(1, (e.clientX - cx) / (cx || 1)));
				const ny = Math.max(-1, Math.min(1, (e.clientY - cy) / (cy || 1)));
				this.targetX = nx;
				this.targetY = ny;

				this.bgTargetX = (e.clientX / window.innerWidth) * 100;
				this.bgTargetY = (e.clientY / window.innerHeight) * 100;
				if (bg) bg.classList.add('is-active');
				schedule();
			};

			const onLeave = () => {
				this.targetX = 0;
				this.targetY = 0;
				if (bg) bg.classList.remove('is-active');
				schedule();
			};

			const onBoing = () => {
				this.classList.remove('is-boing');
				void this.offsetWidth;
				this.classList.add('is-boing');
				window.setTimeout(() => this.classList.remove('is-boing'), 540);
			};

			window.addEventListener('pointermove', onMove, { passive: true });
			document.addEventListener('pointerleave', onLeave);
			this.addEventListener('click', onBoing);
			this.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					onBoing();
				}
			});
		}

		disconnectedCallback() {
			if (this.rafId) cancelAnimationFrame(this.rafId);
		}
	}

	if (!customElements.get('xt-mascot')) {
		customElements.define('xt-mascot', XtMascot);
	}
</script>
